# Python virtual environments
.venv/

# Bytecode and cache
__pycache__/
*.py[cod]

# Configuration overrides
.env
.DS_Store
.gitconfig

# Tooling
.ruff_cache/
.mypy_cache/

# Data artifacts
# Real participant data (excluded)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/kubios_comparison/
data/Kubios_Output_*.zip
local_test_data/
test_data/
tests/data/

# Demo data (included in repo)
!data/demo/
!data/demo/**

# HRV data files (real participant data)
*_RR_*.csv
*_Events_*.csv
!tests/fixtures/**/*_RR_*.csv
!tests/fixtures/**/*_Events_*.csv
!data/demo/**/*_RR_*.csv
!data/demo/**/*_Events_*.csv

# VNS Analyse data files (real participant data)
# Pattern: dd.mm.yyyy hh.mm *.txt
[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]*.txt

# User config directory
~/.music_hrv/

# Build outputs
dist/
build/
*.spec

# Throwaway test screenshots
test_*.png

# uv workspace metadata
.python-version
.uv/

# Claude Code instructions and local settings
AGENTS.md
CLAUDE.md
MEMORY.md
.claude/settings.local.json
MEMORY_ARCHIVE.md
music hrv.md

# Playwright MCP artifacts
.playwright-mcp/

nul

# Personal notes (never delete)
rrational.md

# Internal / non-published docs (not in RTD nav)
docs/development/inspector-plan.md
docs/development/inspector-research.md
docs/reference/HRV_project_spec.md
docs/reference/PLAN_rrational_v2.md
docs/reference/hrv_tools_summary.md

# Dev-time screenshot scratch at the repo root only. The published
# docs/assets/screenshots/ tree is explicitly tracked and must remain
# matchable — pinning the leading slash keeps the pattern from
# eating it.
/screenshots/

# Local-only superpowers plan notes (skill-generated planning material).
docs/superpowers/

# Local-only Claude analysis scratch (sprint research, gap reports, feature
# inventories). Already-committed audits like bids_cardiac_compat.md stay
# tracked via the explicit unignore below.
.claude/analysis/*.md
!.claude/analysis/bids_cardiac_compat.md
.claude/scheduled_tasks.lock

# Local-only test-suite run logs (debug aid for hangs / xdist crashes).
# Regenerated by every `pytest tests/ | tee X.log` invocation.
*_suite*.log
inspector_only.log
inspector_verbose.log
xdist_*.log

# Per-session inspector snapshot harness output.
tests/visual/snapshots/

# Local-only validation script (E2E + Kubios smoke, manually run).
tests/workflow_verification.py
